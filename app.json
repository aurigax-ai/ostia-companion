{
  "expo": {
    "name": "Ostia",
    "slug": "ostia",
    "version": "0.0.5",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "dark",
    "ios": {
      "supportsTablet": true,
      "infoPlist": {
        "NSBonjourServices": [
          "_ostia._tcp"
        ],
        "NSLocalNetworkUsageDescription": "Ostia looks for your desktop on this network so you can pair by typing a code."
      },
      "bundleIdentifier": "ai.aurigax.ostia.remote"
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#F0E9DD",
        "foregroundImage": "./assets/android-icon-foreground.png",
        "backgroundImage": "./assets/android-icon-background.png",
        "monochromeImage": "./assets/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false,
      "package": "ai.aurigax.ostia"
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      "expo-secure-store",
      "expo-status-bar",
      [
        "expo-notifications",
        {
          "icon": "./assets/android-icon-monochrome.png",
          "color": "#f2b347"
        }
      ],
      "expo-sharing",
      "./plugins/withPushStrings.js",
      [
        "expo-speech-recognition",
        {
          "microphonePermission": "Ostia listens while you dictate a message. The speech is recognised on this phone.",
          "speechRecognitionPermission": "Ostia turns your speech into text on this phone."
        }
      ],
      [
        "expo-image-picker",
        {
          "cameraPermission": "Ostia opens the camera to attach a photo to a message.",
          "photosPermission": "Ostia reads the photo you pick to attach to a message."
        }
      ]
    ],
    "backgroundColor": "#161616"
  }
}
