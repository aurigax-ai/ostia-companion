{
  "expo": {
    "name": "Ostia",
    "slug": "ostia",
    "version": "0.0.1",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "dark",
    "ios": {
      "supportsTablet": true,
      "infoPlist": {
        "NSBonjourServices": [
          "_ostia._tcp"
        ],
        "NSLocalNetworkUsageDescription": "Ostia looks for your desktop on this network so you can pair by typing a code."
      },
      "bundleIdentifier": "ai.aurigax.ostia.companion"
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#F0E9DD",
        "foregroundImage": "./assets/android-icon-foreground.png",
        "backgroundImage": "./assets/android-icon-background.png",
        "monochromeImage": "./assets/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false,
      "package": "ai.aurigax.ostia"
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      "expo-secure-store",
      "expo-status-bar",
      [
        "expo-notifications",
        {
          "icon": "./assets/android-icon-monochrome.png",
          "color": "#f2b347"
        }
      ]
    ],
    "backgroundColor": "#161616"
  }
}
