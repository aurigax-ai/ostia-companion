<manifest xmlns:android="http://schemas.android.com/apk/res/android">
  <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
  <uses-permission android:name="android.permission.FOREGROUND_SERVICE_MEDIA_PROJECTION" />
  <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
  <queries>
    <intent>
      <action android:name="android.intent.action.MAIN" />
      <category android:name="android.intent.category.LAUNCHER" />
    </intent>
    <intent>
      <action android:name="android.service.autofill.AutofillService" />
    </intent>
  </queries>
  <application>
    <service
      android:name="expo.modules.phonecontrol.PhoneControlService"
      android:exported="false"
      android:foregroundServiceType="mediaProjection" />
    <service
      android:name="expo.modules.phonecontrol.OstiaAccessibilityService"
      android:exported="false"
      android:label="@string/phone_control_accessibility_label"
      android:permission="android.permission.BIND_ACCESSIBILITY_SERVICE">
      <intent-filter>
        <action android:name="android.accessibilityservice.AccessibilityService" />
      </intent-filter>
      <meta-data
        android:name="android.accessibilityservice"
        android:resource="@xml/phone_control_accessibility" />
    </service>
  </application>
</manifest>
