{
  "name": "ostia-companion",
  "version": "1.0.0",
  "main": "index.ts",
  "packageManager": "pnpm@11.10.0",
  "dependencies": {
    "@expo-google-fonts/inter": "^0.4.2",
    "@expo-google-fonts/jetbrains-mono": "^0.4.1",
    "@noble/hashes": "^2.4.0",
    "@react-navigation/native": "^7.5.0",
    "@react-navigation/native-stack": "^7.20.0",
    "agent-watch": "file:modules/agent-watch",
    "expo": "~57.0.27",
    "expo-camera": "~57.0.6",
    "expo-constants": "~57.0.21",
    "expo-crypto": "~57.0.3",
    "expo-font": "~57.0.4",
    "expo-haptics": "~57.0.3",
    "expo-intent-launcher": "~57.0.1",
    "expo-libghostty": "^0.8.1",
    "expo-modules-core": "~57.0.21",
    "expo-notifications": "~57.0.22",
    "expo-secure-store": "~57.0.4",
    "expo-status-bar": "~57.0.1",
    "expo-system-ui": "~57.0.4",
    "lucide-react-native": "^1.52.0",
    "react": "19.2.3",
    "react-native": "0.86.3",
    "react-native-gesture-handler": "~2.32.0",
    "react-native-safe-area-context": "~5.7.0",
    "react-native-screens": "~4.26.2",
    "react-native-zeroconf": "^0.17.3",
    "tweetnacl": "^1.0.3",
    "websocket-pinning": "file:modules/websocket-pinning"
  },
  "devDependencies": {
    "@expo/dom-webview": "~57.0.1",
    "@jest/globals": "~29.7.0",
    "@react-native/metro-config": "0.86.3",
    "@testing-library/react-native": "^14.0.1",
    "@types/node": "^26.6.4",
    "@types/react": "~19.2.17",
    "@types/ws": "^8.18.2",
    "jest": "~29.7.0",
    "jest-expo": "~57.0.5",
    "typescript": "~7.0.2",
    "vitest": "^5.0.3",
    "ws": "^8.22.0"
  },
  "scripts": {
    "start": "expo start",
    "android": "expo run:android",
    "ios": "expo run:ios",
    "web": "expo start --web",
    "test": "vitest run && jest",
    "mock:gateway": "node tools/mock-gateway.mts"
  },
  "private": true,
  "jest": {
    "preset": "jest-expo",
    "testMatch": [
      "<rootDir>/src/**/*.render.test.tsx"
    ],
    "moduleNameMapper": {
      "^lucide-react-native$": "<rootDir>/node_modules/lucide-react-native/dist/cjs/lucide-react-native.js"
    },
    "transformIgnorePatterns": [
      "/node_modules/(?!(.pnpm|react-native|@react-native|@react-native-community|expo|@expo|@expo-google-fonts|react-navigation|@react-navigation|@sentry/react-native|native-base|standard-navigation|@noble))",
      "/node_modules/react-native-reanimated/plugin/",
      "/node_modules/@react-native/babel-preset/"
    ],
    "setupFiles": [
      "react-native-gesture-handler/jestSetup",
      "<rootDir>/src/testing/jestSetup.ts"
    ]
  }
}
